{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Callio",
  "mainBinaryName": "Callio",
  "version": "0.14.2",
  "identifier": "dev.callio.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Callio",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost 'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'self' asset: http://asset.localhost drawio: http://drawio.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Callio",
    "resources": {
      "../office/bin/callio-office.exe": "callio-office.exe",
      "../vendor/drawio.zip": "drawio.zip"
    },
    "shortDescription": "Callio – Shape your folio",
    "longDescription": "Callio – Shape your folio. A lightweight editor for Markdown, LaTeX, Word documents, spreadsheets, presentations, PDF and pictures, with live preview, SyncTeX and Overleaf sync.",
    "copyright": "© 2026 Minh. MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
